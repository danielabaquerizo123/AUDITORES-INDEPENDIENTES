# Copy to .env for local development. Do not commit real credentials.
DATABASE_URL=postgresql://audit_dev:local_development_password@localhost:5432/audit_dev?schema=public
POSTGRES_DB=audit_dev
POSTGRES_USER=audit_dev
POSTGRES_PASSWORD=local_development_password
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_PATH=../storage
VITE_API_BASE_URL=http://localhost:3000/api
